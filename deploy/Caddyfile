# STUDIO_DOMAIN comes from docker-compose.yml: your domain, which gets a
# certificate and HTTPS once its DNS points here, or ":80" for plain HTTP
# on the VM's IP until then.
{$STUDIO_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	@framed not path /preview/*
	header @framed X-Frame-Options "SAMEORIGIN"
	reverse_proxy app:3000
}

# With a domain, anyone who opens the VM by its IP (or any other name) is
# sent to the domain. remote.sh sets STUDIO_FALLBACK to ":80" only when
# STUDIO_DOMAIN is set; otherwise this block answers a name nobody uses.
{$STUDIO_FALLBACK:http://fallback.invalid} {
	redir https://{$STUDIO_DOMAIN}{uri} permanent
}
