# Copy to .env for local runs. On the VM, deploy/remote.sh writes .env for you.

# Postgres. For a quick try without a database server: DATABASE_URL=pglite:
DATABASE_URL=postgres://studio:secret@localhost:5432/studio
POSTGRES_PASSWORD=secret

# At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=

# Vultr Serverless Inference (OpenAI-compatible). Leave the model empty to use
# the first suitable model your key can see.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=

# GitHub two-way sync: a fine-grained token with Issues read/write on your repos,
# and the secret you give each repo's webhook (pointing at /api/github/webhook).
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Email. Without a key, mail goes to the Activity outbox and nothing is sent.
RESEND_API_KEY=
MAIL_FROM=

# The public demo: show demo logins and load the made-up studio on first start.
DEMO=1
SEED_DEMO=1

# Your domain, once its DNS A record points at the VM. Empty: HTTP on the IP.
STUDIO_DOMAIN=
COOKIE_SECURE=0
